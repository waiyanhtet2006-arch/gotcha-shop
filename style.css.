:root{
--primary:#d4af37; 
--bg:#0f0f0f;
--card-bg:#1a1a1a;
--text:#ffffff;
--danger:#ff4d4d;
--success:#00bfa6;
}
body{margin:0;font-family:'Segoe UI',Roboto,Arial;background:var(--bg);color:var(--text); line-height: 1.6;}
.container{width:95%;max-width:1100px;margin:auto;padding:20px;}

header{text-align:center; padding: 40px 0;}
h1{color:var(--primary); letter-spacing: 0.5em; font-weight: bold; margin-bottom: 20px;}
.nav-bar { display: flex; justify-content: center; gap: 15px; margin-bottom: 30px; border-bottom: 1px solid #333; padding-bottom: 15px; flex-wrap: wrap;}
.nav-link { color: white; text-decoration: none; font-size: 11px; cursor: pointer; opacity: 0.4; transition: 0.3s; text-transform: uppercase; letter-spacing: 1px;}
.nav-link.active { opacity: 1; border-bottom: 2px solid var(--primary); padding-bottom: 5px;}

.page { display: none; animation: fadeIn 0.4s ease; }
.page.active { display: block; }
.section{background:var(--card-bg);padding:30px;border-radius:16px; margin-top: 20px; border: 1px solid #222;}

/* Products */
.products{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:30px;}
.card{background:var(--card-bg);padding:20px;border-radius:16px;border:1px solid #333; text-align: center;}
.card img{width:100%; border-radius:10px;}

/* Qty Controls */
.qty-controls { display: flex; align-items: center; gap: 10px; }
.qty-btn { background: #333; color: white; border: 1px solid #444; border-radius: 4px; padding: 2px 10px; cursor: pointer; font-weight: bold; transition: 0.2s; }
.qty-btn:hover { background: var(--primary); color: black; }

.order-record { background: #222; padding: 20px; border-radius: 12px; margin-bottom: 15px; border-left: 5px solid var(--primary); }
.status-badge { padding: 5px 10px; border-radius: 6px; font-size: 10px; font-weight: bold; text-transform: uppercase; }
.status-pending { background: #444; color: white; }
.status-accepted { background: #b8860b; color: white; }
.status-delivered { background: var(--success); color: black; }

select,input,textarea{width:100%;padding:14px;margin-top:10px;background:#222;border:1px solid #444;border-radius:10px;color:white; box-sizing: border-box;}
.btn{background:var(--primary);color:black;width:100%;margin-top:15px;padding:15px;border:none;border-radius:10px; font-weight: bold; cursor: pointer; text-transform: uppercase; letter-spacing: 1px;}

/* Manual Lookup Styling */
.lookup-box { margin-bottom: 25px; padding-bottom: 20px; border-bottom: 1px solid #333; }
.small-text { font-size: 12px; opacity: 0.6; margin-bottom: 5px; display: block; }

@keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
