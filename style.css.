:root {
    --primary: #d4af37;
    --bg: #ffffff; /* Switched to White for that clean Mixtas look */
    --card-bg: #f9f9f9;
    --text: #111111;
    --radius: 0px; /* Reference image uses sharp, clean edges */
}

body {
    margin: 0;
    font-family: 'Inter', sans-serif;
    background: var(--bg);
    color: var(--text);
}

/* Header - Floating & Clean */
header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 5%;
    background: #fff;
    border-bottom: 1px solid #eee;
    position: sticky;
    top: 0;
    z-index: 1000;
}

h1 { font-size: 20px; letter-spacing: 4px; margin: 0; }

/* Hero Section */
.hero {
    height: 80vh;
    background: url('https://images.unsplash.com/photo-1523381210434-271e8be1f52b?q=80&w=2070') center/cover;
    display: flex;
    align-items: center;
    padding: 0 10%;
    color: white;
}

.hero-content h2 { font-size: 48px; margin-bottom: 20px; text-transform: uppercase; }

/* Product Grid */
.container { width: 90%; max-width: 1200px; margin: 40px auto; }
.section-title { text-align: center; margin-bottom: 40px; font-size: 28px; text-transform: uppercase; }

.products {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
}

.card {
    background: #fff;
    transition: 0.3s;
    text-align: left;
}

.card img { width: 100%; height: 350px; object-fit: cover; background: #f4f4f4; }
.card h3 { font-size: 14px; margin: 15px 0 5px; text-transform: uppercase; }
.card p { color: #666; font-weight: bold; }

/* Banner Grid (Bottom) */
.banner-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 20px;
    margin-top: 60px;
}

.banner-item {
    height: 500px;
    background-size: cover;
    background-position: center;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 40px;
    color: white;
}

/* Buttons */
.btn {
    background: #111;
    color: #fff;
    padding: 12px 25px;
    border: none;
    cursor: pointer;
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 2px;
}

/* Nav Drawer */
.nav-bar {
    position: fixed;
    top: 0;
    right: -100%;
    height: 100vh;
    width: 300px;
    background: white;
    box-shadow: -5px 0 15px rgba(0,0,0,0.1);
    display: flex;
    flex-direction: column;
    padding: 100px 40px;
    gap: 20px;
    transition: 0.4s;
    z-index: 1100;
}
.nav-bar.open { right: 0; }
.nav-link { text-decoration: none; color: #111; font-weight: bold; cursor: pointer; }
